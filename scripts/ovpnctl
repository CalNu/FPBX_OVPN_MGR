#!/bin/bash
#
# ovpnctl - narrow, fixed-purpose root helper for the ovpn_mgr FreePBX module.
#
# This script is the ONLY thing granted to the 'asterisk' user via sudo
# (see scripts/setup-root.sh). It accepts a small fixed set of subcommands,
# each of which validates its own arguments before touching anything
# privileged. No part of an HTTP request is ever folded into a shell
# string - PHP passes only pre-validated primitives as separate argv
# entries, and this script re-validates all of them again itself.
#
# Written to be distro-agnostic: works whether this module ended up on
# the FreePBX Distro (Sangoma Linux / CentOS lineage), a Debian box set
# up via Sangoma's install script, or Incredible PBX. It does not assume
# any one distro's firewall-persistence convention or OpenSSL version.

set -euo pipefail

# --- Locate ourselves and the FreePBX web root without hardcoding it ---
# This script lives at <AMPWEBROOT>/admin/modules/ovpn_mgr/scripts/ovpnctl
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

AMPWEBROOT="$(cd "${MODULE_DIR}/../.." && pwd)"
if [ ! -d "${AMPWEBROOT}/admin/modules" ]; then
    # Unexpected layout - fall back to the common default rather than guess.
    AMPWEBROOT="/var/www/html"
fi

BASE_DIR="${AMPWEBROOT}/PhoneSettings/openvpn"
CONF="${BASE_DIR}/legacy-vpn.conf"
LOG_DIR="${BASE_DIR}/logs"
LOG_FILE="${LOG_DIR}/openvpn.log"
PID_FILE="${BASE_DIR}/openvpn.pid"

STATE_DIR="/etc/ovpn_mgr"
NAT_STATE_FILE="${STATE_DIR}/nat-state"
NAT_MARK="OVPN_MGR_NAT"

is_port()   { [[ "$1" =~ ^[0-9]{1,5}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }
is_cidr()   { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; }
is_iface()  { [[ "$1" =~ ^[a-zA-Z0-9_.@-]{1,15}$ ]]; }

find_bin() {
    # find_bin NAME PATH1 PATH2 ...  - prefer explicit paths, fall back to PATH
    local name="$1"; shift
    for candidate in "$@"; do
        if [ -x "$candidate" ]; then echo "$candidate"; return 0; fi
    done
    command -v "$name" 2>/dev/null || true
}

OPENVPN_BIN="$(find_bin openvpn /usr/sbin/openvpn /usr/local/sbin/openvpn)"
IPTABLES_BIN="$(find_bin iptables /sbin/iptables /usr/sbin/iptables)"

# OpenSSL 1.1 vs 3.x need different handling: SECLEVEL/provider syntax is
# OpenSSL-3-only and OpenVPN will refuse to start with those directives
# present against OpenSSL 1.1 (e.g. stock CentOS 7 / older Debian). Detect
# once and only apply the OpenSSL-3-specific environment when it's safe to.
openssl_major_version() {
    local v
    v="$(openssl version 2>/dev/null | awk '{print $2}' | cut -d. -f1)"
    [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo "0"
}

find_openssl_cnf() {
    for candidate in /etc/ssl/openssl.cnf /etc/pki/tls/openssl.cnf /usr/lib/ssl/openssl.cnf; do
        [ -f "$candidate" ] && { echo "$candidate"; return 0; }
    done
    echo ""
}

cmd="${1:-}"
shift || true

case "$cmd" in

  check)
    echo "ovpnctl ok"
    ;;

  start)
    [ -n "$OPENVPN_BIN" ] || { echo "openvpn binary not found" >&2; exit 1; }
    mkdir -p "$LOG_DIR"
    touch "$LOG_FILE"
    if pgrep -f -- "--config ${CONF}\b" >/dev/null 2>&1; then
      echo "already running"
      exit 0
    fi
    [ -f "$CONF" ] || { echo "missing config: $CONF" >&2; exit 1; }

    if [ "$(openssl_major_version)" -ge 3 ]; then
      openssl_cnf="$(find_openssl_cnf)"
      OPENSSL_CONF="$openssl_cnf" OPENSSL_CIPHER_LIST="DEFAULT:@SECLEVEL=0" \
        "$OPENVPN_BIN" --config "$CONF" \
                        --writepid "$PID_FILE" \
                        --log-append "$LOG_FILE" \
                        --daemon
    else
      "$OPENVPN_BIN" --config "$CONF" \
                      --writepid "$PID_FILE" \
                      --log-append "$LOG_FILE" \
                      --daemon
    fi
    ;;

  stop)
    # Match on the actual running process (by its --config argument),
    # not the pidfile - the pidfile can be stale/missing, and the config
    # file's *current* port may already have been rewritten to a new
    # value by the time this runs (e.g. during a settings save), which
    # would make a port-based lookup kill the wrong thing (or nothing).
    pkill -TERM -f -- "--config ${CONF}\b" 2>/dev/null || true
    sleep 1
    pkill -9 -f -- "--config ${CONF}\b" 2>/dev/null || true
    rm -f "$PID_FILE"
    ip link delete tun0 2>/dev/null || true
    ;;

  ipforward-on)
    sysctl -w net.ipv4.ip_forward=1 >/dev/null
    echo "net.ipv4.ip_forward = 1" > /etc/sysctl.d/99-ovpn-mgr.conf
    ;;

  nat-sync)
    # nat-sync <new_cidr> <wan_iface>
    # Adds/replaces the single MASQUERADE rule this module owns and saves
    # the parameters so `nat-restore` (run by a systemd unit at boot) can
    # reapply them - this deliberately does not depend on any one
    # distro's firewall-persistence file convention.
    [ -n "$IPTABLES_BIN" ] || { echo "iptables not found" >&2; exit 1; }
    cidr="${1:?missing cidr}"
    iface="${2:?missing iface}"

    is_cidr "$cidr"   || { echo "invalid cidr" >&2; exit 1; }
    is_iface "$iface" || { echo "invalid iface" >&2; exit 1; }

    while "$IPTABLES_BIN" -t nat -C POSTROUTING -j MASQUERADE -m comment --comment "$NAT_MARK" 2>/dev/null; do
      "$IPTABLES_BIN" -t nat -D POSTROUTING -j MASQUERADE -m comment --comment "$NAT_MARK"
    done
    "$IPTABLES_BIN" -t nat -I POSTROUTING 1 -s "$cidr" -o "$iface" -j MASQUERADE -m comment --comment "$NAT_MARK"

    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$cidr" "$iface" > "$NAT_STATE_FILE"
    chmod 600 "$NAT_STATE_FILE"
    ;;

  nat-restore)
    # Run at boot by ovpn-mgr-nat.service. No-op if nothing was ever saved.
    [ -f "$NAT_STATE_FILE" ] || exit 0
    [ -n "$IPTABLES_BIN" ] || exit 0
    read -r cidr iface < "$NAT_STATE_FILE"
    is_cidr "$cidr" && is_iface "$iface" || exit 0

    "$IPTABLES_BIN" -t nat -C POSTROUTING -j MASQUERADE -m comment --comment "$NAT_MARK" 2>/dev/null \
      || "$IPTABLES_BIN" -t nat -I POSTROUTING 1 -s "$cidr" -o "$iface" -j MASQUERADE -m comment --comment "$NAT_MARK"
    ;;

  port-sync)
    # port-sync <port>
    # STANDALONE-FIREWALL FALLBACK ONLY - used when the FreePBX Firewall
    # module isn't present (a plain FreePBX-on-Debian/Ubuntu box with
    # nothing but stock iptables, no Sysadmin/Firewall). Creates/maintains
    # a dedicated 'ovpn_mgr' chain, jumped from INPUT, containing exactly
    # one ACCEPT rule for the current OpenVPN UDP port. Idempotent: the
    # chain is flushed and rebuilt rather than accumulating a duplicate
    # rule every time the port changes. This never touches any other
    # chain, rule, or the box's default policy - it only ever adds this
    # one jump + this one rule inside its own chain.
    [ -n "$IPTABLES_BIN" ] || { echo "iptables not found" >&2; exit 1; }
    port="${1:?missing port}"
    is_port "$port" || { echo "invalid port" >&2; exit 1; }

    "$IPTABLES_BIN" -N ovpn_mgr 2>/dev/null || true
    "$IPTABLES_BIN" -C INPUT -j ovpn_mgr 2>/dev/null || "$IPTABLES_BIN" -I INPUT -j ovpn_mgr
    "$IPTABLES_BIN" -F ovpn_mgr
    "$IPTABLES_BIN" -A ovpn_mgr -p udp --dport "$port" -j ACCEPT -m comment --comment "OVPN_MGR_PORT"

    mkdir -p "$STATE_DIR"
    printf '%s\n' "$port" > "${STATE_DIR}/port-state"
    chmod 600 "${STATE_DIR}/port-state"
    ;;

  port-restore)
    # Run at boot (same service as nat-restore). No-op if port-sync was
    # never run on this box - i.e. a no-op on any system where FreePBX's
    # Firewall module handled the port instead.
    [ -f "${STATE_DIR}/port-state" ] || exit 0
    [ -n "$IPTABLES_BIN" ] || exit 0
    read -r port < "${STATE_DIR}/port-state"
    is_port "$port" || exit 0

    "$IPTABLES_BIN" -N ovpn_mgr 2>/dev/null || true
    "$IPTABLES_BIN" -C INPUT -j ovpn_mgr 2>/dev/null || "$IPTABLES_BIN" -I INPUT -j ovpn_mgr
    "$IPTABLES_BIN" -F ovpn_mgr
    "$IPTABLES_BIN" -A ovpn_mgr -p udp --dport "$port" -j ACCEPT -m comment --comment "OVPN_MGR_PORT"
    ;;

  *)
    echo "usage: ovpnctl {check|start|stop|ipforward-on|nat-sync|nat-restore|port-sync|port-restore}" >&2
    exit 1
    ;;
esac
